-- [APARTADO 1] Ver Nombre de Jugadores (Más grande, blanco y oculta el nombre nativo de Roblox)
local espNamesEnabled = false
local espBillboards = {}
local robloxDisplays = {}

local function createNameTag(p)
	if p == player then return end
	
	p.CharacterAdded:Connect(function(char)
		local humanoid = char:WaitForChild("Humanoid", 5)
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			robloxDisplays[p] = humanoid
		end
	end)
	if p.Character then
		local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			robloxDisplays[p] = humanoid
		end
	end

	local function onCharacter(char)
		if not espNamesEnabled then return end
		local head = char:WaitForChild("Head", 5)
		if head and not head:FindFirstChild("UniversalEspTag") then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "UniversalEspTag"
			billboard.Size = UDim2.new(0, 220, 0, 60)
			billboard.StudsOffset = Vector3.new(0, 3.2, 0)
			billboard.AlwaysOnTop = true
			billboard.Parent = head

			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 1, 0)
			textLabel.BackgroundTransparency = 1
			textLabel.Text = p.Name
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			textLabel.TextStrokeTransparency = 0.1
			textLabel.TextSize = 22
			textLabel.Font = Enum.Font.GothamBold
			textLabel.Parent = billboard

			espBillboards[p] = billboard
		end
	end
	
	if p.Character then
		onCharacter(p.Character)
	end
	p.CharacterAdded:Connect(onCharacter)
end

local function removeNameTag(p)
	if espBillboards[p] then
		espBillboards[p]:Destroy()
		espBillboards[p] = nil
	end
	if robloxDisplays[p] and robloxDisplays[p].Parent then
		robloxDisplays[p].DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		robloxDisplays[p] = nil
	end
end

createButtonInTab("tab1", "Ver Nombre de Jugadores", function(enabled)
	espNamesEnabled = enabled
	if enabled then
		for _, p in ipairs(Players:GetPlayers()) do
